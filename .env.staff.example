# Dedicated private ASD Industry staff backend (OFF by default).
# Do not enable or connect to ASDP Staging or ASD Pay databases.
STAFF_BACKEND_ENABLED=false
NODE_ENV=development
# STAFF_DB_URL=postgresql://<restricted-login>@<host>/asd_industry_staff
# Only in a trusted admin terminal; NEVER set on public Render:
# STAFF_ADMIN_DB_URL=postgresql://<database-owner>@<host>/asd_industry_staff
# STAFF_ORIGIN=https://your-private-staff-service.example
# STAFF_SESSION_PEPPER=<at-least-32-random-characters>
# For private terminal staff provisioning only:
# NEW_STAFF_EMAIL=<staff-address>
# NEW_STAFF_PASSWORD=<unique-strong-password-at-least-16-characters>
# NEW_STAFF_ROLE=reviewer
# v0.7 uses rule-based report packets, not automatic AI inference.
# AI_STAFF_ENABLED=false
