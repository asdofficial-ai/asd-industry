# Dedicated private ASD Industry staff backend (OFF by default).
# Do not enable or connect to ASDP Staging or ASD Pay databases.
STAFF_BACKEND_ENABLED=false
NODE_ENV=development
# STAFF_DB_URL=postgresql://<restricted-login>@<host>/asd_industry_staff
# Only in a trusted admin terminal; NEVER set on public Render:
# STAFF_ADMIN_DB_URL=postgresql://<database-owner>@<host>/asd_industry_staff
# STAFF_ORIGIN=https://your-private-staff-service.example
# STAFF_SESSION_PEPPER=<at-least-32-random-characters>
# For private terminal staff provisioning only:
# NEW_STAFF_EMAIL=<staff-address>
# NEW_STAFF_PASSWORD=<unique-strong-password-at-least-16-characters>
# NEW_STAFF_ROLE=reviewer
# v0.7 uses rule-based report packets, not automatic AI inference.
# AI_STAFF_ENABLED=false

# Required before any private staff backend activation:
# STAFF_MFA_KEY=<64-random-hexadecimal-characters>
# For private Founder authenticator enrollment ONLY, on the owner's trusted terminal:
# NEW_STAFF_EMAIL=<provisioned-founder-email>
# CONFIRM_FOUNDER_MFA_SETUP=I_AM_ON_A_PRIVATE_TERMINAL
# CONFIRM_MFA_RESET=I_AUTHORIZE_RESET  # only for a separately authorized reset
# Never copy the authenticator URI, recovery material or password into chat.

# Google Founder verification uses a personal Gmail with no paid domain:
# FOUNDER_PENDING_EMAIL=<personally-approved-founder-gmail>
# GOOGLE_CLIENT_ID=<web-oauth-client-id.apps.googleusercontent.com>
# FOUNDER_GOOGLE_VERIFICATION_ENABLED=false
# Verify Gmail via Google before privately provisioning a Founder account.
# Google verification NEVER activates administrative privileges.
