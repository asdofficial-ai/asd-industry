# ASD Industry v0.4 isolated PRIVATE beta example.
# Never commit real secrets or personal data.
# To prevent accounts from being opened to minors, accounts beta defaults OFF.
NODE_ENV=development
ACCOUNTS_BETA_ENABLED=false

# Configure ONLY in a private adult-test sandbox, after a dedicated database is migrated:
# DATABASE_URL=postgresql://<private-host>/<asd-industry-db>
# PUBLIC_ORIGIN=https://your-private-beta-service.example
# BETA_INVITE_CODE=<generate-a-long-random-invite>
# DO NOT use the ASD Pay database.
